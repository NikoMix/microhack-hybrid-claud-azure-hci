{
  // markdownlint configuration — https://github.com/DavidAnson/markdownlint
  "default": true,
  "MD013": false, // line length — disabled (prose + tables)
  "MD024": { "siblings_only": true }, // duplicate headings allowed across sections
  "MD033": false, // inline HTML allowed (badges, details)
  "MD041": false, // first line need not be H1 (front-matter/badges)
  "MD046": false, // code block style flexible
  "MD036": false, // emphasis-as-heading allowed in trainer notes
  "MD028": false, // blank line inside blockquote (GitHub admonitions)
  "MD060": false  // table pipe spacing/alignment — cosmetic only, hand-authored tables
}
