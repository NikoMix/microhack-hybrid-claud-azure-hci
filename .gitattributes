# Normalize line endings: repo is consumed in Linux Codespaces.
* text=auto eol=lf

# Scripts and Linux-consumed files MUST be LF (CRLF breaks the shebang on Linux).
*.sh        text eol=lf
*.bash      text eol=lf
*.tf        text eol=lf
*.tfvars    text eol=lf
*.hcl       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.md        text eol=lf
Taskfile.yml text eol=lf
Dockerfile  text eol=lf

# Binary assets — never normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.svg       text eol=lf
*.drawio    text eol=lf
*.xlsx      binary
*.pdf       binary
