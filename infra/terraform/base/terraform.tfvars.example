# Copy to terraform.tfvars and adjust. (terraform.tfvars is gitignored.)

# Required: short, unique pupil initials (2-5 lowercase alphanumeric chars).
initials = "abc"

# Optional overrides:
# location = "swedencentral"

# STRONGLY recommended: lock SSH to your own public IP/CIDR.
# Find it with: curl -s https://api.ipify.org
